# Video pesado
*.mp4
*.mov
*.avi

# Node
node_modules/

# Entornos Python / secretos
env/
venv/
.venv/
__pycache__/
*.pyc
.env

# Temporales
*.draft
.DS_Store

# Salida del render (conservar .gitkeep)
out/*
!out/.gitkeep

# Frames temporales del QC loop
pipeline/qc_frames/

# Config local de MCP (cada persona autoriza con su cuenta)
.mcp.json

# Artefactos generados por el pipeline (el ejemplo versionado vive en pipeline/examples/)
pipeline/transcript.json
pipeline/*.wav
pipeline/*.mp3
pipeline/transcript.source.json

# Recursos pesados o con licencia propia: se comparten por Drive, no por Git
assets/raw/*
assets/music/*
assets/sfx/*
!assets/raw/.gitkeep
!assets/music/.gitkeep
!assets/sfx/.gitkeep
pipeline/*.m4a

# Prototipo de control de tomas: datos de trabajo (fichas, proxies, salidas)
tomas_data/
